# Model: alias is shared by llama-server and the API, repo and file are downloaded on first start.
# Chosen by the evaluation in README; the other evaluated models are listed there.
MODEL_ALIAS=qwen3-4b-instruct-2507-q4km
LLAMA_ARG_HF_REPO=bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF
LLAMA_ARG_HF_FILE=Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf

# llama-server: context is split between slots (8192 / 2 = 4096 per slot).
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_N_PARALLEL=2
LLAMA_ARG_THREADS=6
# Batch 512 lets a cancelled request free its slot within seconds during prompt processing.
LLAMA_ARG_BATCH=512
# Prompt cache in host RAM, MiB. 0 turns it off: the shared prompt prefix is still reused
# inside each slot, and llama-server's default of 8192 is larger than the memory limit.
LLAMA_ARG_CACHE_RAM=0
LLAMA_ARG_MMPROJ_AUTO=off
LLAMA_ARG_ENDPOINT_METRICS=1
LLAMA_ARG_OFFLINE=0

# Resources: limits per container; see the benchmark tables and the server sizing table in README before changing them.
LLM_CPUS=6
LLM_MEM_LIMIT=6656m
API_CPUS=1
API_MEM_LIMIT=512m
# healthy comes with the first successful check, so a long window costs nothing.
LLM_START_PERIOD=1800s

# API: published address and runtime probe settings.
# API_KEY: when set, /classify and /v1/* need the header "Authorization: Bearer <API_KEY>"; empty means no check.
# Use `openssl rand -hex 32`; $, quotes and # are not allowed because compose would change them. /health and /ready stay open.
API_KEY=
# Ports published by Docker bypass ufw rules.
API_BIND=127.0.0.1
API_PORT=8000
LLM_PROBE_TIMEOUT_S=2.0
LOG_LEVEL=INFO

# Concurrency: the number of requests the API classifies at once equals LLAMA_ARG_N_PARALLEL,
# otherwise extra requests wait inside llama-server and that wait eats REQUEST_TIMEOUT_S.
# A request waits at most QUEUE_TIMEOUT_S for a slot, with at most MAX_QUEUE waiting; then 429.
MAX_QUEUE=4
QUEUE_TIMEOUT_S=30

# Classification: limits measured on 8 vCPU for Granite 4.1 3B and checked on the other evaluated models.
# REQUEST_TIMEOUT_S covers both attempts of one request, counted from the moment it gets a slot.
# A retry starts only with at least 5 s left, so below 5 there is never a retry.
REQUEST_TIMEOUT_S=120
MAX_INPUT_CHARS=3000
MAX_REQUEST_BYTES=262144
MAX_OUTPUT_TOKENS=256
LLM_TEMPERATURE=0.0
# Set true for models that think by default (Qwen3.5-2B does under llama-server and then returns an empty answer).
LLM_DISABLE_THINKING=false

# Model selection (docker compose --profile select run --rm selector): see README.
# Download and load of one model, seconds; not part of SELECT_MODEL_MAX_S.
SELECT_LOAD_TIMEOUT_S=1800
# A model fails when the slowest smoke answer takes longer, seconds.
SELECT_TARGET_P95_S=30
# Smoke test and long input of one model after it loaded, seconds.
SELECT_MODEL_MAX_S=1200
