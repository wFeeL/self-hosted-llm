# Model: alias is shared by llama-server and the API, repo and file are downloaded on first start.
# Chosen by the evaluation in README; the other evaluated models are listed there.
MODEL_ALIAS=qwen3.5-2b-q4km
LLAMA_ARG_HF_REPO=bartowski/Qwen_Qwen3.5-2B-GGUF
LLAMA_ARG_HF_FILE=Qwen_Qwen3.5-2B-Q4_K_M.gguf

# llama-server: context is split between slots (8192 / 2 = 4096 per slot).
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_N_PARALLEL=2
LLAMA_ARG_THREADS=6
# Batch 512 lets a cancelled request free its slot within seconds during prompt processing.
LLAMA_ARG_BATCH=512
LLAMA_ARG_MMPROJ_AUTO=off
LLAMA_ARG_ENDPOINT_METRICS=1
LLAMA_ARG_OFFLINE=0

# Resources: limits per container, not measured yet.
LLM_CPUS=6
LLM_MEM_LIMIT=6g
API_CPUS=1
API_MEM_LIMIT=512m
# Time the llm healthcheck tolerates while the model downloads and loads; raise it on slow networks.
LLM_START_PERIOD=600s

# API: published address and runtime probe settings.
# API_KEY: when set, /classify and /v1/* need the header "Authorization: Bearer <API_KEY>"; empty means no check.
# Use `openssl rand -hex 32`; $, quotes and # are not allowed because compose would change them. /health and /ready stay open.
API_KEY=
# Ports published by Docker bypass ufw rules.
API_BIND=127.0.0.1
API_PORT=8000
LLM_PROBE_TIMEOUT_S=2.0
LOG_LEVEL=INFO

# Concurrency: keep MAX_CONCURRENCY equal to LLAMA_ARG_N_PARALLEL, otherwise extra
# requests wait inside llama-server and that wait eats REQUEST_TIMEOUT_S.
# A request waits at most QUEUE_TIMEOUT_S for a slot, with at most MAX_QUEUE waiting; then 429.
MAX_CONCURRENCY=2
MAX_QUEUE=4
QUEUE_TIMEOUT_S=30

# Classification: limits measured for Granite 4.1 3B on 8 vCPU and checked on Qwen3.5-2B.
# REQUEST_TIMEOUT_S covers both attempts of one request, counted from the moment it gets a slot.
# A retry starts only with at least 5 s left, so below 5 there is never a retry.
REQUEST_TIMEOUT_S=120
MAX_INPUT_CHARS=3000
MAX_REQUEST_BYTES=262144
MAX_OUTPUT_TOKENS=256
LLM_TEMPERATURE=0.0
# Qwen3.5-2B thinks by default under llama-server and then returns an empty answer: keep this true for it.
LLM_DISABLE_THINKING=true
